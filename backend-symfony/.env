# Symfony Environment
APP_ENV=dev
APP_SECRET=ChangeThisSecretKeyInProductionWithAtLeast32Chars

# Database
DATABASE_URL="mysql://root:secret@mysql:3306/ecommerce?serverVersion=8.0&charset=utf8mb4"

# Redis
REDIS_URL=redis://redis:6379

# CORS
CORS_ALLOW_ORIGIN=^http://localhost:3000$

# JWT
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
JWT_PASSPHRASE=ecommerce_jwt_passphrase

# Queue Configuration
QUEUE_ENABLED=true
QUEUE_MAX_CONCURRENT_USERS=100
QUEUE_BYPASS_TOKEN=bypass-secret-token

# Frontend URL
FRONTEND_URL=http://localhost:3000

###> symfony/routing ###
# Configure how to generate URLs in non-HTTP contexts, such as CLI commands.
# See https://symfony.com/doc/current/routing.html#generating-urls-in-commands
DEFAULT_URI=http://localhost
###< symfony/routing ###

###> symfony/mailer ###
MAILER_DSN=null://null
###< symfony/mailer ###
